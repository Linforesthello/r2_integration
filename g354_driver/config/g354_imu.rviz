Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame: imu_link
      Marker Scale: 0.3
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true

    - Class: rviz_imu_plugin/Imu
      Name: IMU
      Enabled: true
      Topic:
        Value: /imu/data
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Orientation:
        Enabled: true
        Color: 255; 255; 0
        Length: 0.3
        Offset: 0.0
        Alpha: 0.8
      Acceleration:
        Enabled: true
        Color: 255; 0; 0
        Length: 0.5
        Offset: 0.0
        Alpha: 0.7
      Angular Velocity:
        Enabled: true
        Color: 0; 255; 0
        Length: 0.4
        Offset: 0.0
        Alpha: 0.7
      Covariance:
        Enabled: false
      Value: true

  Global Options:
    Fixed Frame: imu_link
    Frame Rate: 30

  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
    - Class: rviz_default_plugins/SetGoal

  Window Geometry:
    Height: 800
    Width: 1200
