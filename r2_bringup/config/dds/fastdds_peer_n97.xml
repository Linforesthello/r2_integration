<?xml version="1.0" encoding="UTF-8" ?>
<!-- VM(NAT) → N97 单播发现配置：VMware NAT 不转发组播，需显式指定对端 -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <participant profile_name="unicast_peer_n97" is_default_profile="true">
    <rtps>
      <builtin>
        <initialPeersList>
          <locator>
            <udpv4>
              <address>192.168.1.210</address>
              <port>7410</port>
            </udpv4>
          </locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>
</profiles>
