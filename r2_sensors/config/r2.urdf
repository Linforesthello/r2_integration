<?xml version="1.0"?>
<robot name="r2">

  <!-- 车身（底盘中心，离地高度0） -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.8 0.6 0.15"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.3 0.8 0.8"/>
      </material>
    </visual>
  </link>

  <!-- VLP-16 雷达（车顶中心，水平安装） -->
  <link name="velodyne"/>

  <!-- base_link → velodyne（实测: 地面77.5cm - base_link 12cm = 65.5cm, 2026-08-24） -->
  <joint name="velodyne_joint" type="fixed">
    <parent link="base_link"/>
    <child link="velodyne"/>
    <origin xyz="0 0 0.655"/>  <!-- 实测定案2026-08-24: 光学中心距地77~78 - base_link12 = 65.5cm（08-06 曾定 69-13=56cm，雷达安装已抬高） -->
    <axis xyz="0 0 1"/>
  </joint>

</robot>
